<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="16dp">

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Not connected"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:ellipsize="end"
            android:maxLines="1"/>

        <Button
            android:id="@+id/btnScan"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Scan"
            android:textSize="13sp"
            android:backgroundTint="#1976D2"
            android:textColor="#FFFFFF"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>

        <Button
            android:id="@+id/btnDisconnect"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Disconnect"
            android:textSize="13sp"
            android:backgroundTint="#B71C1C"
            android:textColor="#FFFFFF"
            android:layout_marginStart="8dp"
            android:enabled="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>

    </LinearLayout>

    <!-- SCANNING PROGRESS -->
    <ProgressBar
        android:id="@+id/progressScanning"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:indeterminateTint="#1976D2"
        android:visibility="gone"
        android:layout_marginBottom="8dp"/>

    <!-- ── SCAN PANEL (visible when NOT connected) ── -->
    <LinearLayout
        android:id="@+id/layoutScanPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- DEVICE LIST -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDevices"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="12dp"/>

        <!-- DEVICE COUNT -->
        <TextView
            android:id="@+id/tvDeviceCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Devices found: 0"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

    </LinearLayout>

    <!-- ── CONNECTED PANEL (visible when connected) ── -->
    <LinearLayout
        android:id="@+id/layoutConnectedPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="16dp">

        <!-- SPEED AND BATTERY ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#1E1E1E"
                android:padding="12dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SPEED"
                    android:textColor="#888888"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/tvSpeedValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- km/h"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#1E1E1E"
                android:padding="12dp"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BATTERY"
                    android:textColor="#888888"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/tvBatteryValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--%"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

        <!-- ROW 1: HEADLIGHT + SIDE LEDs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- HEADLIGHT BUTTON -->
            <LinearLayout
                android:id="@+id/btnHeadlight"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#1E3A5F"
                android:layout_marginEnd="6dp"
                android:minHeight="48dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡"
                    android:textSize="36sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Headlight"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp"/>

                <TextView
                    android:id="@+id/tvHeadlightState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFF"
                    android:textColor="#888888"
                    android:textSize="11sp"/>

            </LinearLayout>

            <!-- SIDE LEDs BUTTON -->
            <LinearLayout
                android:id="@+id/btnSideLights"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#1E3A5F"
                android:layout_marginStart="6dp"
                android:minHeight="48dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔵"
                    android:textSize="36sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Side LEDs"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp"/>

                <TextView
                    android:id="@+id/tvSideLightsState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ON"
                    android:textColor="#4CAF50"
                    android:textSize="11sp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- ROW 2: BLINKERS + BELL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- BLINKERS BUTTON -->
            <LinearLayout
                android:id="@+id/btnBlinkers"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#1E3A5F"
                android:layout_marginEnd="6dp"
                android:minHeight="48dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡"
                    android:textSize="36sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Blinkers"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TAP TO BLINK"
                    android:textColor="#888888"
                    android:textSize="11sp"/>

            </LinearLayout>

            <!-- BELL BUTTON -->
            <LinearLayout
                android:id="@+id/btnBell"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#1E3A5F"
                android:layout_marginStart="6dp"
                android:minHeight="48dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔔"
                    android:textSize="36sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bell"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TAP TO RING"
                    android:textColor="#888888"
                    android:textSize="11sp"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>